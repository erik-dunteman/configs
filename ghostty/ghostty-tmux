#!/bin/sh
set -eu

# Finder-launched apps may not have Homebrew in PATH.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

# A dedicated server keeps Ghostty sessions separate from other tmux work.
# Reopen a detached session; otherwise give each native tab its own session.
session=$(
    tmux -L ghostty list-sessions -f '#{==:#{session_attached},0}' \
        -F '#{session_last_attached} #{session_id}' 2>/dev/null |
        sort -rn | awk 'NR == 1 { print $2 }'
)
if [ -n "$session" ]; then
    exec tmux -L ghostty attach-session -t "$session"
fi
exec tmux -L ghostty new-session

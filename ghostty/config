font-family = Code New Roman
font-size = 16
theme = Dark Modern
foreground = #ffffff

shell-integration-features = ssh-env,ssh-terminfo

# Each native window/tab is a frontend for a local tmux session.
command = shell:"$HOME/.local/bin/ghostty-tmux"

# Send tmux's prefix + binding; no prefix needs to be typed manually.
keybind = cmd+d=text:\x02D
keybind = cmd+shift+d=text:\x02H
keybind = cmd+e=text:\x02X
keybind = cmd+[=text:\x02P
keybind = cmd+]=text:\x02N
# Detach from the active remote/local session, keeping its panes running.
keybind = cmd+shift+e=text:\x02Q

# Don't prompt when closing a surface with a running process
confirm-close-surface = false

# Cursor trail (jcmorrow/dotfiles); also applies to SSH sessions.
custom-shader = ~/.config/ghostty/shaders/cursor-trail.glsl

export PATH="$HOME/.local/bin:$PATH"

# tmux starts the shell, so load Ghostty's integration explicitly.
if [[ -n "$TMUX" && -n "$GHOSTTY_RESOURCES_DIR" &&
      -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
    source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi
if [[ -r "$HOME/.config/ghostty/tmux.zsh" ]]; then
    source "$HOME/.config/ghostty/tmux.zsh"
fi

VIRTUAL_ENV_DISABLE_PROMPT=1
_set_prompt() {
    local venv=""
    [[ -n "$VIRTUAL_ENV" ]] && venv="(${VIRTUAL_ENV:t}) "
    PROMPT="
${venv}%F{214}%~%f %# "
}
precmd_functions+=(_set_prompt)

bindkey -v

# bun completions
[ -s "/Users/erik/.bun/_bun" ] && source "/Users/erik/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

alias yolo="claude --dangerously-skip-permissions"

# make `code` open Zed
alias code="/Applications/Zed.app/Contents/MacOS/cli"

# opencode
export PATH=/Users/erik/.opencode/bin:$PATH

# Atuin history search
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"
